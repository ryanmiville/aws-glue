{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "aws-glue",
  "title": "AWS Glue",
  "description": "Find, open, and run AWS Glue jobs.",
  "icon": "command-icon.png",
  "author": "ryanmiville",
  "categories": [
    "Developer Tools"
  ],
  "license": "MIT",
  "commands": [
    {
      "name": "index",
      "title": "Glue Jobs",
      "description": "Find and open a glue job (or run it)",
      "mode": "view"
    }
  ],
  "dependencies": {
    "@aws-sdk/client-glue": "^3.515.0",
    "@raycast/api": "^1.98.4",
    "@raycast/utils": "^1.17.0",
    "@smithy/shared-ini-file-loader": "^2.3.1",
    "zod": "^4.0.5"
  },
  "devDependencies": {
    "@raycast/eslint-config": "^2.0.4",
    "@types/bun": "latest",
    "@types/node": "22.13.10",
    "@types/react": "19.0.10",
    "eslint": "^9.22.0",
    "prettier": "^3.5.3",
    "typescript": "^5.8.2"
  },
  "scripts": {
    "build": "ray build -e dist",
    "dev": "ray develop",
    "fix-lint": "ray lint --fix",
    "lint": "ray lint",
    "publish": "npx @raycast/api@latest publish"
  },
  "module": "src/index.tsx",
  "type": "module",
  "private": true
}
